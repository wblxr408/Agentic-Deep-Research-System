# Docker Compose project
COMPOSE_PROJECT_NAME=deepintel

# LLM
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# Optional Agnes provider: select it in model settings or use LLM_PROVIDER=agnes.
# China: https://api.agnes-ai.cn/v1 ; international credentials use their own endpoint.
# AGNES_MODEL=agnes-3.0-flash
# AGNES_API_BASE=https://api.agnes-ai.cn/v1
# Development delegation reads AGNES_API_KEY from the process environment, or on
# Windows the current user's DPAPI file (default ~/.codex/secrets/agnes-adrs.dpapi).
# AGNES_API_KEY_FILE=

# Optional OpenMinion Cortensor run (independent of LLM_*; use your issued endpoint/session).
# CORTENSOR_API_URL=https://your-issued-endpoint/api/v2/completions
# CORTENSOR_API_KEY=
# CORTENSOR_MODEL=gpt-oss-20b
# CORTENSOR_SESSION_ID=1
# CORTENSOR_API_MODE=auto
# Portal alternative (hosted text-only path; requires its own key and model access):
# CORTENSOR_API_URL=https://api.cortensor.app/v1
# CORTENSOR_MODEL=oss-20b
# CORTENSOR_API_MODE=openai_chat

# Optional fallback LLM
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-chat
LLM_FALLBACK_API_KEY=

# Host-side app access
DATABASE_URL=postgresql://deepintel:deepintel_secret@localhost:5433/deepintel
REDIS_URL=redis://localhost:6379/0

# Docker internal service access
DOCKER_DATABASE_URL=postgresql://deepintel:deepintel_secret@db:5432/deepintel
DOCKER_REDIS_URL=redis://redis:6379/0

# Database container
POSTGRES_DB=deepintel
POSTGRES_USER=deepintel
POSTGRES_PASSWORD=deepintel_secret
POSTGRES_PORT=5433

# Redis container
REDIS_PORT=6379

# RAG
RAG_EMBED_MODEL=BAAI/bge-zh-qwen2-int8
# Optional dense representation requires a pinned 40-character artifact commit.
# RAG_EMBED_REVISION=
RAG_ENABLE_DENSE_RETRIEVAL=false
RAG_ENABLE_RERANKER=false
RAG_EMBED_DIMENSION=1024
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=cpu
RAG_RETRIEVAL_TOP_K=20
RAG_RERANK_TOP_N=10
RAG_RRF_K=60

# Browser
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_POOL_SIZE=2
PLAYWRIGHT_NAVIGATION_TIMEOUT=30000

# API / Frontend ports
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_LOG_LEVEL=INFO
FRONTEND_PORT=5173

# Security: generate a unique long random value before any production startup.
SECURITY_AUTH_ENABLED=true
SECURITY_ENVIRONMENT=production
SECURITY_ENCRYPTION_KEY=replace-with-a-unique-long-random-secret
SECURITY_SECURE_COOKIES=true
SECURITY_REGISTRATION_ENABLED=true
SECURITY_REGISTRATION_RATE_LIMIT=6
SECURITY_UPLOAD_MAX_BYTES=26214400
SECURITY_UPLOAD_MAX_PAGES=500
RESILIENCE_CAPABILITY_RETRY_SECONDS=30

# Channel configuration / maintenance history (owner-scoped; contains no tokens)
CHANNELS_STATE_ROOT=./data/channels
# Windows npm tools: map to native node.exe + installed CLI entry, never a .cmd shim.
# CHANNELS_TOOL_PREFIXES={"opencli":["C:/Program Files/nodejs/node.exe","C:/tools/opencli/dist/src/main.js"]}
# Optional trusted file; default config/channel-tools.local.json is generated by scripts/setup_channel_tools.ps1
# CHANNELS_TOOL_PREFIXES_FILE=D:/Agentic-Deep-Research-System/config/channel-tools.local.json
# Export these in the API process environment when using a dedicated browser/session:
# OPENCLI_CDP_ENDPOINT=http://127.0.0.1:9223
# CHANNELS_LINKEDIN_SESSION_READY=true  # only after manual login in the isolated profile
# Set platform credentials deliberately in the API process environment when needed.
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=

# Historical local acceptance scripts (only execute when the task authorizes them).
# Supply disposable accounts and an isolated database through the process environment.
# ADRS_E2E_PASSWORD=
# ADRS_E2E_OTHER_PASSWORD=
# ADRS_E2E_DATABASE_URL=

# Structured local document parsing; OCR needs explicit upload selection too.
DOCUMENT_PARSING_TIMEOUT_SECONDS=25
DOCUMENT_PARSING_MAX_CHARS=160000
DOCUMENT_PARSING_OCR_ENABLED=false
DOCUMENT_PARSING_OCR_BINARY=tesseract
DOCUMENT_PARSING_OCR_LANGUAGE=eng
DOCUMENT_PARSING_MAX_OCR_PAGES=8
